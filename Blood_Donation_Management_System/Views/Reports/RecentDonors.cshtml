@model List<Blood_Donation_Management_System.EF.Tables.Donor>

<h2>Donors Sorted by Last Donation Date (Most Recent First)</h2>

<table border="1" cellpadding="6">
    <tr>
        <th>Full Name</th>
        <th>Blood Group</th>
        <th>Last Donation Date</th>
    </tr>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.FullName</td>
            <td>@d.BloodGroup</td>
            <td>@(d.LastDonationDate?.ToString("yyyy-MM-dd") ?? "Never donated")</td>
        </tr>
    }
</table>

<p><a href="/Donor/Index">Back to Donors</a></p>
