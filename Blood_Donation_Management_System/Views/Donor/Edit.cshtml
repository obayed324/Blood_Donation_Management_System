@model Blood_Donation_Management_System.EF.Tables.Donor

<h2>Edit Donor</h2>
@Html.ValidationSummary()

<form method="post">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <p>
        Full Name:<br />
        <input type="text" name="FullName" value="@Model.FullName" />
    </p>
    <p>
        Blood Group:<br />
        <input type="text" name="BloodGroup" value="@Model.BloodGroup" />
    </p>
    <p>
        Contact No:<br />
        <input type="text" name="ContactNo" value="@Model.ContactNo" />
    </p>
    <p>
        City:<br />
        <input type="text" name="City" value="@Model.City" />
    </p>
    <p>
        Last Donation Date:<br />
        <input type="date" name="LastDonationDate" value="@(Model.LastDonationDate?.ToString("yyyy-MM-dd"))" />
    </p>
    <input type="submit" value="Save Changes" />
</form>
<a href="/Donor/Index">Back to List</a>
