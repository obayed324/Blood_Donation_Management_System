@model Blood_Donation_Management_System.EF.Tables.Donor

<h2>Delete Donor</h2>
<p>Are you sure you want to delete this donor?</p>
<p><b>Full Name:</b> @Model.FullName</p>
<p><b>Blood Group:</b> @Model.BloodGroup</p>

<form method="post">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <button type="submit" name="Dcsn" value="Yes">Yes, Delete</button>
    <button type="submit" name="Dcsn" value="No">Cancel</button>
</form>
